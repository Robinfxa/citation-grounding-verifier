# Codex/ChatGPT-plan route: run `grounding-auth login`, then `grounding-auth models`.
# Minimal is the measured faster, lower-token LLM default; optimized remains opt-in.
GROUNDING_APPROACH=minimal
GROUNDING_PROVIDER=codex
# Choose an exact available model ID. Both LLM approaches use this same model.
GROUNDING_MODEL=
GROUNDING_AUTH_PROFILE=default
# Optional API-key route: set GROUNDING_PROVIDER=openai.
# Copy this file to .env. Never commit .env or paste a key into chat.
OPENAI_API_KEY=
# Optional OpenAI-compatible endpoint. Leave blank for api.openai.com.
OPENAI_BASE_URL=
# API cost estimates require a dated JSON snapshot passed to `grounding-eval run --prices`.
# Codex/ChatGPT-plan usage is never converted to an inferred per-token dollar cost.
# GROUNDING_MAX_OUTPUT_TOKENS is sent only to the OpenAI API route.
# Codex does not apply that token cap; evaluation metadata records it explicitly.

# Optional experimental Jev methods: jev_minimal or jev_optimized.
# Keep the default approach above until you explicitly select an experiment.
# GROUNDING_PROVIDER / GROUNDING_MODEL select the generative LLM for extraction/fallback.
# TypeSafe credentials are independent; never place a real key in this example file.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.14.0
# TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
GROUNDING_JEV_FALLBACK=true
# Experimental thresholds; these are not calibrated accuracy guarantees.
GROUNDING_JEV_LABEL_THRESHOLD=0.8
GROUNDING_JEV_EVIDENCE_THRESHOLD=0.8
GROUNDING_JEV_REASON_THRESHOLD=0.8
# Local serialized-byte limits, not provider token limits; context is never truncated.
GROUNDING_JEV_MAX_REQUEST_BYTES=256000
GROUNDING_JEV_MAX_QUESTION_BYTES=128000
