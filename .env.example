# Codex/ChatGPT-plan route: run `grounding-auth login`, then `grounding-auth models`.
GROUNDING_APPROACH=optimized
GROUNDING_PROVIDER=codex
# Choose an exact available model ID. Both LLM approaches use this same model.
GROUNDING_MODEL=
GROUNDING_AUTH_PROFILE=default
# Optional API-key route: set GROUNDING_PROVIDER=openai.
# Copy this file to .env. Never commit .env or paste a key into chat.
OPENAI_API_KEY=
# Optional OpenAI-compatible endpoint. Leave blank for api.openai.com.
OPENAI_BASE_URL=
# API cost estimates require a dated JSON snapshot passed to `grounding-eval run --prices`.
# Codex/ChatGPT-plan usage is never converted to an inferred per-token dollar cost.
